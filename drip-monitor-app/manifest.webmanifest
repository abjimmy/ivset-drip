{
  "id": "drip-lens",
  "name": "滴准 · 实时滴速监测",
  "short_name": "滴准",
  "description": "通过设备摄像头在本机实时分析莫菲氏滴管滴注速度。",
  "lang": "zh-CN",
  "start_url": "./?source=camera&autostart=1",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#071416",
  "theme_color": "#071416",
  "categories": ["medical", "utilities", "productivity"],
  "icons": [
    {
      "src": "icons/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "开始摄像头检测",
      "short_name": "检测",
      "url": "./?source=camera&autostart=1",
      "icons": [{ "src": "icons/app-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "测试识别",
      "short_name": "测试",
      "url": "./?source=test",
      "icons": [{ "src": "icons/app-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}

